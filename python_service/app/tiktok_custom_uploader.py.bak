import sys
import os
import argparse
import traceback

# Ensure the library is in PYTHONPATH
REPO_DIR = "/app/tiktok_uploader"
if REPO_DIR not in sys.path:
    sys.path.append(REPO_DIR)

from tiktok_uploader.Browser import Browser
from tiktok_uploader.Video import Video

def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--video", required=True)
    parser.add_argument("--title", required=True)
    parser.add_argument("--cookies", required=True)
    parser.add_argument("--proxy", default=None)
    args = parser.parse_args()

    # Paths
    # Staged video name is relative to TIKTOK_REPO_DIR during execution (from publish.py)
    # but publish.py passes staged_name which is just the basename.
    # The actual path is TIKTOK_REPO_DIR / VideosDirPath / staged_name
    video_path = os.path.join(REPO_DIR, "VideosDirPath", args.video)
    
    # Path to cookies
    cookie_path = os.path.join(REPO_DIR, args.cookies)

    print(f"[*] Iniciando upload TikTok - Vídeo: {args.video}")
    print(f"[*] Usando cookies: {cookie_path}")

    try:
        # 1. Initialize Browser
        browser = Browser(cookies=cookie_path, proxy=args.proxy)
        
        # 2. Check login if possible (Best effort)
        # 3. Create Video object
        video = Video(video_path, args.title)
        
        # 4. Upload
        print("[*] Enviando vídeo para o TikTok...")
        result = browser.upload(video)
        
        if result:
            print("[+] Upload concluído com sucesso!")
            sys.exit(0)
        else:
            print("[-] Falha no upload (browser retornou False)")
            sys.exit(1)
            
    except Exception as e:
        print(f"[-] Erro crítico durante o upload: {e}")
        traceback.print_exc()
        sys.exit(1)

if __name__ == "__main__":
    main()
